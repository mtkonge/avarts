{
    "tasks": {
        "dev": "deno run -A npm:vite",
        "build": "deno run -A npm:vite build"
    },
    "fmt": {
        "indentWidth": 4
    },
    "nodeModulesDir": "auto",
    "compilerOptions": {
        "types": [],
        "lib": [
            "dom",
            "dom.iterable",
            "deno.ns"
        ]
    },
    "imports": {
        "maplibre-gl": "npm:maplibre-gl@^5.24.0",
        "vite": "npm:vite@^8.0.10"
    }
}